# the minimum amount of time after which the API will be synchronized
# example:
# - 1d 12h
# - 30m
# - 4w
# default: 12h
MIN_SYNC_DELAY=12h

# prefix for all static files. It can be useful when the site is not deployed on a pure domain, but for example on /siteURI
# example:
# - /jetCDNparse
# - /githubPages
STATIC_PREFIX=

# the useragent with which the API request will be made
USER_AGENT=


